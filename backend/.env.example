DATABASE_URL=sqlite:///./school_enrichment.db
# Local dev/CI only -- tells the app it's safe to fall back to the default
# SECRET_KEY below and to allow the localhost:3000 CORS origin. Never set
# this in a real deployment (Render doesn't; see render.yaml). See
# app/core/config.py's SECRET_KEY startup guard (A13, 30 Sep 2026 review).
ENVIRONMENT=development
SECRET_KEY=dev-secret-change-me
# Encrypts every user's TOTP (2FA) secret at rest -- see
# app/core/config.py's TOTP_ENCRYPTION_KEY section. Must be a Fernet key:
# 32 random bytes, url-safe base64 (44 characters ending in "="). Generate
# one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Several keys may be given comma-separated (newest first) to rotate: the
# first one encrypts, all of them decrypt. Leaving it blank locally falls
# back to a public dev-only key (ENVIRONMENT=development only -- production
# refuses to boot or migrate without a real one). In production, back the
# key up: if it is lost, every enrolled user's 2FA has to be reset.
TOTP_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
SENTRY_DSN=
