DATABASE_URL=sqlite:///./school_enrichment.db
# Local dev/CI only -- tells the app it's safe to fall back to the default
# SECRET_KEY below and to allow the localhost:3000 CORS origin. Never set
# this in a real deployment (Render doesn't; see render.yaml). See
# app/core/config.py's SECRET_KEY startup guard (A13, 30 Sep 2026 review).
ENVIRONMENT=development
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
SENTRY_DSN=
